<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>공범 프로젝트</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<header class="border-bottom bg-white">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between" style="height: 56px;">

            <div class="ps-3">
                <a href="/recruits?userId={{userId}}" class="text-decoration-none text-dark fw-semibold">
                <h5 class="mb-0">🫵공범</h5>
                </a>
            </div>

            <div class="d-flex align-items-center gap-3">
                <a href="/recruits/new?userId={{userId}}" class="btn btn-primary btn-sm">
                + 공범 모집하기
                </a>

                <div class="d-flex align-items-center ps-3 border-start">
                    <span class="text-dark small">{{userId}}</span>
                </div>
            </div>

        </div>
    </div>
</header>