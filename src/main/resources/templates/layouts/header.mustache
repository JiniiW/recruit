<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>공범 프로젝트</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<header class="border-bottom" style="background: #fff;">
    <div class="container">
        <div style="height: 56px; display: flex; align-items: center; justify-content: space-between;">
            <div style="padding-left: 16px">
                <a href="/recruits/userId={{userId}}" style="font-size: 15px; font-weight: 600; color: #111; text-decoration: none; letter-spacing: -0.3px;">
                🫵공범
                </a>
            </div>

            <div style="display: flex; align-items: center; gap: 16px;">

                <a href="/recruits/new?userId={{userId}}" style="font-size: 13px; color: #fff; background: #3b82f6; text-decoration: none; padding: 7px 16px; border-radius: 6px; font-weight: 500;">
                    + 새 모집글 작성
                </a>

                <div style="display: flex; align-items: center; gap: 8px; padding-left: 16px; padding-right: 16px; border-left: 1px solid #eee;">
                    <span style="font-size: 13px; color: #000000;">{{userId}}</span>
                </div>

            </div>
        </div>
    </div>
</header>

<!--rttr 메시지 표시-->
{{#msg}}
    <div class="alert alert-primary alert-dismissible">
        {{msg}}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
    </div>
{{/msg}}